# ── AWS Athena configuration ────────────────────────────────────────────────────
# Used by: soc-estimate-athena CLI and AthenaDataSource
# All values can also be passed as CLI flags (--aws_profile, --database, etc.)
# CLI flags always take precedence over these environment variables.

# AWS named profile (from ~/.aws/credentials). Leave blank to use the default profile
# or instance role (e.g. on EC2/Lambda).
AWS_PROFILE=infra_dev

# AWS region where your Athena workgroup lives.
AWS_REGION=eu-west-1

# Athena database and table that hold your battery telemetry.
ATHENA_DATABASE=battery_data
ATHENA_TABLE=measurements

# S3 path where Athena writes query results.
# The IAM principal must have s3:PutObject on this prefix.
ATHENA_S3_OUTPUT=s3://your-bucket/athena-results/
